# Eclipse workspace metadata (IDE-generated, not project source)
.metadata/
**/.metadata/

# Java build output
backend-java/target/

# Claude Code local settings
.claude/settings.local.json
**/.claude/settings.local.json

# OS files
Thumbs.db
.DS_Store

# IDE
.vscode/
.idea/

# Python venv for the deal-scoring model service
xgboost/.venv/
xgboost/.pytest_cache/
xgboost/.ruff_cache/
**/__pycache__/

# AI: base model and trained adapter weights — large binaries, not source.
# Replaces the former Llama3_CRM/.gitignore and DealIntelligence_CRM/.gitignore.
ai/base-model/
ai/adapters/*/weights/

# Carried over from those two files so nothing they hid becomes visible:
# training logs, local venvs, caches.
ai/adapters/*/logs/
*.pyc
venv/
.venv/
.pytest_cache/
hf_cache/
.ipynb_checkpoints/

# Deal scorer audit log — appended on every /score call, local runtime output.
xgboost/outputs/prediction_log.jsonl

# Local Ollama install (binaries, ~3GB) — models are pulled, not committed.
Ollama/

# Marketing adapter dataset generation: resume cursor and progress log.
ai/adapters/marketing/data/content.state.json
ai/adapters/marketing/data/*.log

# Output of servers restarted by ai/tools/train_offline.py.
ai/logs/

# Marketing retraining (ai/tools/retrain.py). feedback/benchmark rows are built
# from real CRM leads and campaigns, so they must never be committed.
ai/adapters/marketing/candidate/
ai/adapters/marketing/weights.prev-*/
ai/adapters/marketing/data/feedback.jsonl
ai/adapters/marketing/data/benchmark.jsonl
ai/adapters/marketing/data/benchmark_seed.jsonl

# Trained LoRA adapter weights: large binaries rebuilt by training, and over
# GitHub's 100 MB file limit. The small JSON configs and metrics beside them
# stay in Git as provenance.
ai/adapters/*/weights_v*/**/*.safetensors
ai/adapters/*/weights_v*/**/*.pt
ai/adapters/*/weights_v*/**/tokenizer.json
ai/adapters/*/weights_v*/checkpoint-*/

# Server run logs written while the app is running.
*.run.log
