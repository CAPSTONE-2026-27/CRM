# PostgreSQL connection string (see: prisma migrate dev)
DATABASE_URL="postgresql://user:password@localhost:5432/techcrm?schema=public"

# JWT secrets — generate with `openssl rand -hex 32`
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Gen-AI: OpenAI-compatible endpoint. Point this at a real self-hosted
# server (vLLM / Ollama, AI_API_KEY left blank) once your fine-tuned model
# is ready, or at a free hosted API for testing in the meantime — e.g. Groq
# (https://console.groq.com/keys, baseURL "https://api.groq.com/openai/v1").
AI_PROVIDER="local"
AI_BASE_URL="http://localhost:8000/v1"
AI_MODEL_NAME="qwen2.5-14b-instruct-crm-ft"
AI_API_KEY=""
AI_REQUEST_TIMEOUT_MS="30000"

# RPA worker queue
REDIS_URL="redis://localhost:6379"

PORT="4000"
CORS_ORIGIN="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"

# Session secret — only used transiently to hold OAuth CSRF state during the
# Google/Microsoft handshake. Generate with `openssl rand -hex 32`.
SESSION_SECRET=""

# Google OAuth — create credentials at https://console.cloud.google.com/apis/credentials
# (OAuth client ID -> Web application). Add "<API_URL>/auth/google/callback" as an
# authorized redirect URI, e.g. http://localhost:4000/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Microsoft OAuth — register an app at https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps
# (Azure App Registrations -> New registration). Add "<API_URL>/auth/microsoft/callback"
# as a redirect URI under Authentication. MICROSOFT_TENANT_ID can be a specific
# tenant GUID, or "common" to allow any Microsoft/work/school account.
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"
