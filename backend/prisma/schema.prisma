generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ──────────────────────────────────────────────

enum Role {
  ADMIN
  MANAGER
  SALES_REP
  SUPPORT_AGENT
}

// Whether an account may sign in. Deactivated users keep their records
// (leads they own, audit history) but are refused at login.
enum UserStatus {
  ACTIVE
  INACTIVE
}

enum IdentityProvider {
  AZURE_AD
  OKTA
  LOCAL
}

enum AuthProvider {
  LOCAL
  GOOGLE
  MICROSOFT
}

enum LeadCaptureMethod {
  WEB_FORM
  EMAIL_PARSING
  RPA_BOT_IMPORT
}

enum LeadStatus {
  NEW
  WARM
  HOT
  COLD
}

enum DealStage {
  PROSPECTING
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

enum ContactRole {
  DECISION_MAKER
  CHAMPION
  INFLUENCER
  GATEKEEPER
}

enum CasePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CaseStatus {
  OPEN
  IN_PROGRESS
  ESCALATED
  RESOLVED
  CLOSED
}

enum CampaignChannel {
  EMAIL
  SMS_EMAIL
  MULTI_CHANNEL
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  COMPLETED
}

enum WorkflowNodeType {
  TRIGGER
  CONDITION
  AI
  RPA
  ACTION
  LOG
}

enum RpaPlatform {
  UIPATH
  AUTOMATION_ANYWHERE
  BLUE_PRISM
}

enum RpaBotType {
  UNATTENDED
  ATTENDED
}

enum RpaBotStatus {
  REGISTERED
  SCHEDULED
  RUNNING
  ERROR
  DEPLOYED
}

enum RpaRunStatus {
  RUNNING
  SCHEDULED
  SUCCESS
  ERROR
}

// ── Tenancy & Identity ────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users              User[]
  accounts           Account[]
  contacts           Contact[]
  leads              Lead[]
  deals              Deal[]
  cases              Case[]
  campaigns          Campaign[]
  workflowDefinitions WorkflowDefinition[]
  rpaBots            RpaBot[]
  rpaBotRuns         RpaBotRun[]
  auditLogs          AuditLog[]
  leadMeetings       LeadMeeting[]
}

model User {
  id                    String            @id @default(cuid())
  organizationId        String
  organization          Organization      @relation(fields: [organizationId], references: [id])
  email                 String
  passwordHash          String?           // null for OAuth-only accounts — see authProvider
  authProvider          AuthProvider      @default(LOCAL)
  providerAccountId     String?           // Google/Microsoft's own user id, for returning-user matching
  avatarUrl             String?
  emailVerified         Boolean           @default(false)
  fullName              String
  jobTitle              String?
  phone                 String?
  department            String?
  role                  Role
  status                UserStatus        @default(ACTIVE)
  reportingManagerId    String?
  reportingManager      User?             @relation("ManagerReports", fields: [reportingManagerId], references: [id])
  reports               User[]            @relation("ManagerReports")
  permissionScope       String?           // "Own records" | "Team records" | "All records"
  permissions           String[]          // per-screen access keys; seeded from role, admin-overridable. ADMIN bypasses.
  dataRegion            String?
  identityProvider      IdentityProvider  @default(LOCAL)
  mfaEnabled            Boolean           @default(false)
  ssoEnabled            Boolean           @default(false)
  ldapSyncEnabled       Boolean           @default(false)
  sessionTimeoutMinutes Int               @default(60)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  refreshTokens     RefreshToken[]
  leadsAssigned     Lead[]                @relation("LeadAssignee")
  dealsOwned        Deal[]                @relation("DealOwner")
  accountsOwned     Account[]             @relation("AccountOwner")
  casesAssigned     Case[]                @relation("CaseAssignee")
  campaignsOwned    Campaign[]            @relation("CampaignOwner")
  workflowsCreated  WorkflowDefinition[]
  auditLogsAsActor  AuditLog[]            @relation("AuditActor")
  meetingsRecorded  LeadMeeting[]         @relation("MeetingRecorder")

  @@unique([organizationId, email])
  @@unique([authProvider, providerAccountId])
  @@index([organizationId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// ── Core CRM ───────────────────────────────────────────

model Account {
  id                          String       @id @default(cuid())
  organizationId              String
  organization                Organization @relation(fields: [organizationId], references: [id])
  name                        String
  industry                    String?
  annualRevenue               Decimal?     @db.Decimal(14, 2)
  employeeCount               String?      // e.g. "51-200"
  billingAddress              String?
  parentAccountId             String?
  parentAccount               Account?     @relation("AccountHierarchy", fields: [parentAccountId], references: [id])
  childAccounts               Account[]    @relation("AccountHierarchy")
  ownerId                     String?
  owner                       User?        @relation("AccountOwner", fields: [ownerId], references: [id])
  relationshipValue           Decimal?     @db.Decimal(14, 2)
  aiSentimentScore            Int?         // 0-100
  emailIntegrationEnabled     Boolean      @default(false)
  telephonyIntegrationEnabled Boolean      @default(false)
  docRepoSyncEnabled          Boolean      @default(false)
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @updatedAt

  contacts Contact[]
  deals    Deal[]
  cases    Case[]

  @@index([organizationId])
}

model Contact {
  id                  String       @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id])
  accountId           String
  account              Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  fullName            String
  jobTitle            String?
  email               String?
  phone               String?
  role                ContactRole?
  isPrimary           Boolean      @default(false)
  emailNotifications  Boolean      @default(true)
  smsNotifications    Boolean      @default(false)
  createdAt           DateTime     @default(now())

  @@index([organizationId])
  @@index([accountId])
}

model Lead {
  id                 String            @id @default(cuid())
  organizationId     String
  organization       Organization      @relation(fields: [organizationId], references: [id])
  fullName           String
  company             String
  industry            String?  // filled by the lead-enrichment bot
  employeeCount       String?  // filled by the lead-enrichment bot
  email               String?
  phone               String?
  product             String?
  estimatedDealValue Decimal?          @db.Decimal(14, 2)
  sourceChannel      String?
  captureMethod      LeadCaptureMethod @default(WEB_FORM)
  notes               String?           @db.Text
  aiScore            Int?
  aiScoreLabel       String?           // "Hot lead" | "Warm lead" | "Cold lead"
  aiScoreReason      String?           @db.Text
  status              LeadStatus        @default(NEW)
  assignedToId       String?
  assignedTo         User?             @relation("LeadAssignee", fields: [assignedToId], references: [id])
  salesTeam          String?
  territory           String?
  firstResponseSla   String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  meetings           LeadMeeting[]

  @@index([organizationId])
  @@index([assignedToId])
}

// One row per customer meeting logged by a sales rep against a lead. Records
// are append-only history — a new meeting never overwrites an earlier one, and
// each keeps the before/after score so the lead's scoring trail is auditable.
model LeadMeeting {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id])
  leadId            String
  lead              Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  recordedById      String?
  recordedBy        User?        @relation("MeetingRecorder", fields: [recordedById], references: [id])

  meetingDate       DateTime     @db.Date
  meetingTime       String       // "HH:mm" as entered by the rep, kept as local wall-clock time
  meetingOutput     String       @db.Text
  aiSummary         String       @db.Text // AI-generated, reviewable/editable before save

  previousScore     Int?         // lead's aiScore before this meeting (null if never scored)
  updatedScore      Int?
  scoreChangeReason String?      @db.Text
  aiModelVersion    String?

  createdAt         DateTime     @default(now())

  @@index([organizationId])
  @@index([leadId])
}

model Deal {
  id                     String       @id @default(cuid())
  organizationId         String
  organization           Organization @relation(fields: [organizationId], references: [id])
  name                   String
  accountId              String
  account                Account      @relation(fields: [accountId], references: [id])
  value                  Decimal      @db.Decimal(14, 2)
  currency               String       @default("USD")
  expectedCloseDate      DateTime?
  stage                  DealStage    @default(PROSPECTING)
  probability            Int?         // 0-100
  ownerId                String?
  owner                  User?        @relation("DealOwner", fields: [ownerId], references: [id])
  forecastCategory       String?      // e.g. "Commit"
  weightedForecastValue  Decimal?     @db.Decimal(14, 2)
  bestCaseValue          Decimal?     @db.Decimal(14, 2)
  autoGenerateProposal   Boolean      @default(false)
  pushToErpOnClose       Boolean      @default(false)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@index([organizationId])
  @@index([accountId])
  @@index([stage])
}

model Case {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  caseNumber     Int          @default(autoincrement())
  subject        String
  source         String?      // "Email bot" | "Web form" | ...
  priority       CasePriority @default(MEDIUM)
  slaDeadline    DateTime?
  status         CaseStatus   @default(OPEN)
  accountId      String?
  account        Account?     @relation(fields: [accountId], references: [id])
  assignedToId   String?
  assignedTo     User?        @relation("CaseAssignee", fields: [assignedToId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, caseNumber])
  @@index([organizationId])
}

model Campaign {
  id              String          @id @default(cuid())
  organizationId  String
  organization    Organization    @relation(fields: [organizationId], references: [id])
  name            String
  channel         CampaignChannel @default(EMAIL)
  goal            String?
  budget          Decimal?        @db.Decimal(14, 2)
  ownerId         String?
  owner           User?           @relation("CampaignOwner", fields: [ownerId], references: [id])
  startDate       DateTime?
  endDate         DateTime?
  segment         String?
  region          String?
  estimatedReach  Int?
  status          CampaignStatus  @default(DRAFT)
  sentCount       Int             @default(0)
  openRatePct     Int?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([organizationId])
}

// ── Workflow engine & RPA ──────────────────────────────

model WorkflowDefinition {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  triggerEvent   String?
  scope          String?
  runMode        String?
  isActive       Boolean      @default(false)
  nodes          Json         // [{ type, title, label, operation, order }]
  createdById    String?
  createdBy      User?        @relation(fields: [createdById], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  runs RpaBotRun[]

  @@index([organizationId])
}

model RpaBot {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id])
  name               String
  platform           RpaPlatform
  botType            RpaBotType   @default(UNATTENDED)
  triggerSource      String?
  credentialVaultRef String?
  environment        String?
  region             String?
  version            String?
  status             RpaBotStatus @default(REGISTERED)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  runs RpaBotRun[]

  @@index([organizationId])
}

model RpaBotRun {
  id                   String              @id @default(cuid())
  organizationId       String
  organization         Organization        @relation(fields: [organizationId], references: [id])
  botId                String
  bot                  RpaBot              @relation(fields: [botId], references: [id])
  workflowDefinitionId String?
  workflowDefinition   WorkflowDefinition? @relation(fields: [workflowDefinitionId], references: [id])
  status               RpaRunStatus        @default(SCHEDULED)
  tasksCompleted       Int                 @default(0)
  startedAt            DateTime            @default(now())
  finishedAt           DateTime?
  logs                 String?             @db.Text
  triggeredBy          String?             // "event" | "schedule" | "manual"
  errorMessage         String?
  aiModelVersion        String?             // provenance: which model made the AI-driven decision
  aiConfidence          Float?

  @@index([organizationId])
  @@index([botId])
}

// ── Compliance ──────────────────────────────────────────

model AuditLog {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id])
  occurredAt        DateTime     @default(now())
  actorType         String       // "user" | "bot" | "system"
  actorUserId       String?
  actorUser         User?        @relation("AuditActor", fields: [actorUserId], references: [id])
  actorLabel        String?      // e.g. bot name when actorType = "bot"
  event             String
  detail            String?
  ipAddress         String?
  severity          String       // "ok" | "info" | "warning" | "alert"
  relatedEntityType String?
  relatedEntityId   String?
  aiModelVersion    String?      // provenance for AI-driven decisions
  aiConfidence      Float?

  @@index([organizationId])
  @@index([occurredAt])
}

// Full record of each LLM lead-scoring exchange (prompt + response). Was a
// separate local SQLite file; now lives in Postgres so nothing is stored
// locally. Doubles as future fine-tuning data.
model ScoringConversation {
  id             String   @id @default(cuid())
  organizationId String
  leadId         String
  model          String
  systemPrompt   String   @db.Text
  userPrompt     String   @db.Text
  response       String   @db.Text
  outcome        String   // "scored" | "parse_failed" | "ai_error"
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([leadId])
}
