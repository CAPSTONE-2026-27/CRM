# Copy to application-local.yml (gitignored) and fill in your own values.
# application.yml imports it automatically when present, and every setting here
# can equally be supplied as an environment variable.

spring:
  datasource:
    # --- Local PostgreSQL ---
    url: jdbc:postgresql://localhost:5432/crm_spring
    # Homebrew PostgreSQL authenticates as your macOS user with trust auth,
    # in which case the password stays empty.
    username: your-postgres-user
    password: ""

    # --- Hosted PostgreSQL (Neon and similar) ---
    # url: jdbc:postgresql://<endpoint>.neon.tech/<database>?sslmode=require
    # username: <role>
    # password: <password>

  # Only needed on hosted databases whose role has an empty search_path — Neon
  # is one. Without these, Flyway aborts with "Unable to determine current
  # schema" and JPA can't resolve unqualified table names. The JDBC
  # currentSchema parameter alone does not survive Neon's connection pooler.
  #
  # flyway:
  #   schemas: public
  #   default-schema: public
  #   # Neon's free tier suspends compute when idle, so the first connection
  #   # after a pause can fail before the instance is awake.
  #   connect-retries: 5
  #   # The Neon instance is shared with the rest of the team, so it carries
  #   # migrations from branches that are not merged yet -- V19 (contracts) and
  #   # V20 (contract drafting status) were applied against it on 5 and 8 Sep
  #   # from work that has not been pushed. Without this, Flyway refuses to
  #   # start the moment a local migration is numbered above theirs, because
  #   # the applied versions then fall inside the range it validates.
  #   #
  #   # Scoped to this local profile deliberately: "missing" means Flyway stops
  #   # objecting to applied migrations whose files are absent, which is right
  #   # for a shared development database and wrong for production, where a
  #   # missing file means someone deleted history. Remove once V19/V20 land.
  #   ignore-migration-patterns: "*:missing"
  # jpa:
  #   properties:
  #     hibernate:
  #       default_schema: public

# Any OpenAI-compatible chat-completions endpoint. application.yml already
# defaults to the local fine-tuned model, so this block only needs uncommenting
# if you want to point somewhere else.
#
# Local fine-tuned model (the default — start Llama3_CRM/scripts/main.py first).
# Note 8001: XgBoost/serve_api.py already occupies 8000.
# ai:
#   base-url: http://localhost:8001/v1
#   model-name: crm-llama-3.1-8b-lora
#   api-key: ""
#   request-timeout-ms: 180000
#
# Hosted fallback:
# ai:
#   base-url: https://api.groq.com/openai/v1
#   model-name: llama-3.1-8b-instant
#   api-key: your-api-key
#   request-timeout-ms: 30000

# ---------------------------------------------------------------------------
# OAuth (Google / Microsoft sign-in)
#
# Spring Boot 4 validates every declared registration at startup and refuses to
# boot on a blank client-id ("Client id of registration 'google' must not be
# empty"). application.yml declares both providers, so both need SOME value even
# when SSO is unused.
#
# The placeholders below are enough to start the application. Email/password
# login via POST /api/auth/login works normally; only the "Sign in with Google"
# and "Sign in with Microsoft" buttons will fail. Replace with real values from
# the Google Cloud and Azure consoles if you need SSO.
#
# Redirect URIs are registered against http://localhost:8080/login/oauth2/code/*
# — if you run the backend on another port or host, add the matching URI in both
# consoles, or sign-in fails AFTER the user has already authenticated, which
# looks like a backend bug rather than a configuration one.
#
# MICROSOFT_TENANT_ID must match how the Azure app registration is set up. It is
# interpolated into the authorize, token and JWKS URLs together:
#
#   consumers   personal Microsoft accounts only (outlook.com, hotmail, live)
#   organizations   work and school accounts only
#   common      both
#   <tenant GUID>   one specific organization
#
# Get this wrong and Microsoft still shows its sign-in page, then rejects the
# token exchange afterwards with AADSTS9002331 — the user lands back on the
# login screen and the app looks broken. TechCRM's registration is personal
# accounts only, so "consumers" is the value that matches it. It is set at the
# bottom of this file, outside the "spring:" block, because that is the name
# application.yml interpolates.
# ---------------------------------------------------------------------------
  security:
    oauth2:
      client:
        registration:
          google:
            client-id: local-dev-placeholder
            client-secret: local-dev-placeholder
          azure:
            client-id: local-dev-placeholder
            client-secret: local-dev-placeholder

app:
  jwt:
    # Generate with: openssl rand -hex 32
    access-secret: replace-me-with-a-long-random-secret

# Which Microsoft accounts may sign in. See the OAuth notes above for the other
# values; this must match the Azure app registration's supported account types.
MICROSOFT_TENANT_ID: consumers

# --- Contract and proposal generation (the two SAP BPA bots) ---
# application.yml already carries working defaults, so this block is only needed
# where LibreOffice is somewhere unusual, or not installed at all.
#
# contract:
#   libreoffice:
#     # Windows:
#     path: "C:/Program Files/LibreOffice/program/soffice.exe"
#     # macOS:
#     # path: /Applications/LibreOffice.app/Contents/MacOS/soffice
#     # No LibreOffice on this machine? Documents then generate as DOCX only and
#     # cannot be emailed to the customer.
#     # enabled: false
#   storage:
#     root: ./var/contracts
#
# Proposals share contract.storage.root rather than taking a second one.

# --- Mailjet (emails the contract or proposal PDF to the customer) ---
# Leave unset to develop without it: POST /api/contracts/{id}/send-email and
# /api/proposals/{id}/send-email then return 503. Keys: Mailjet -> Account
# Settings -> API Key Management. from-email must be a sender verified in
# Mailjet, or every send is refused.
#
# mailjet:
#   api-key: your-mailjet-api-key
#   secret-key: your-mailjet-secret-key
#   from-email: you@yourdomain.com
#   from-name: Your Name
