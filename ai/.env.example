# Environment for server/main.py. Copy to .env and adjust.
#
# main.py does not load this file itself — export the variables in your shell or
# process manager before starting it. Every value below is optional: unset, each
# path defaults to the same location relative to main.py.
#
# Relative paths resolve against the working directory, which is ai/:
#   cd ai
#   python server/main.py

# --- model paths ------------------------------------------------------------
CRM_MODEL_PATH=base-model/Llama-3.1-8B-Instruct
CRM_ADAPTER_PATH=adapters/lead_scoring/weights
CRM_MEETING_ADAPTER_PATH=adapters/lead_meeting/weights
CRM_DEAL_STATE_ADAPTER_PATH=adapters/deal_state/weights

# --- server (defaults shown) ------------------------------------------------
# CRM_HOST=0.0.0.0
# CRM_PORT=8001
# CRM_SERVED_MODEL_NAME=crm-llama-3.1-8b-lora

# --- generation (defaults shown) --------------------------------------------
# CRM_MAX_NEW_TOKENS=1024
# CRM_LEAD_MAX_NEW_TOKENS=280
# CRM_MEETING_MAX_NEW_TOKENS=200
# CRM_DEAL_STATE_MAX_NEW_TOKENS=768
# CRM_NORMALISE_LEAD_SCORE=1
# CRM_CHAT_TEMPERATURE=0.7

# --- training ---------------------------------------------------------------
# adapters/deal_state/train.py reads this; the other two train scripts use the
# default base-model path unconditionally.
# CRM_BASE_MODEL=base-model/Llama-3.1-8B-Instruct
